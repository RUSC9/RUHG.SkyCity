<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Business Listing | Sky City</title>
</head>
<body>

    <h1>Edit Your Business Listing</h1>

    <form action="/business-listings/<%= listing._id %>/edit"
    method="Post">

    <label for="businessName">Business Name</label>
    <input
    type="text"
    id="businessName"
    name="businessName"
    value="<%= listing.businessName || '' %>"
    required>
    
    <br><br>

    <label for="businessCategory">Business Category</label>
    <input
    type="text"
    id="businessCategory"
    name="businessCategory" 
    value="<%= listing.businessCategory || '' %>"
    required>

    <br><br>

    <label for ="description">Business Description</label>
    <textarea
    id="description"
    name="description"
    rows="5"
    ><%= listing.description || '' %></textarea>
   

    <br><br>

    <label for="contactPhone">Contact Phone</label>
    <input 
    type="tel"
    id="contactPhone"
    name="contactPhone" 
    value=" <%= listing.contactPhone || '' %>"
    required>

    <br><br>

    <label for="contactEmail">Contact Email</label>
    <input
    type="email"
    id="contactEmail"
    name="contactEmail"
    value=" <%= listing.contactEmail || '' %>"
    required>

    <br><br>
    
    <label for="website">Website</label>
    <input
    type="url"
    id="website"
    name="website"
    value=" <%= listing.website || '' %>">

    <br><br>

    <h2>Business Address</h2>
    <label for="street">Street Address</label>
    <input
    type="text"
    id="street"
    name="street"
    value=" <%= listing.street || '' %>"
    required>

    <br><br>

    <label for="city">City*</label>
    <input
    type="text"
    id="city"
    name="city"
    value=" <%= listing.city || '' %>"
    required>

    <br><br>

    <label for="state">State*</label>
    <input
    type="text"
    id="state"
    name="state"
    value=" <%= listing.state || '' %>"
    required>

    <br><br>

    <label for="zipCode">ZIP Code*</label>
    <input
    type="text"
    id="zipCode"
    name="zipCode"
    value=" <%= listing.zipCode || '' %>"
    required>

    <br><br>

    <label for="serviceArea">Service Area</label>
    <input
    type="text"
    id="serviceArea"
    name="serviceArea"
    value=" <%= listing.serviceArea || '' %>"
    placeholder="Example: Atlanta Metro Area">

    <br><br>

    <label for="businessHours">Business Hours</label>
    <textarea
    id="businessHours"
    name="businessHours"
    rows="4"
    required
    placeholder="Example: Mon-Fri 9AM-6PM"
    ><%= listing.businessHours || '' %></textarea>
    
    <br><br>

    <h2>Customer Option</h2>

    <label>
        <input
        type="checkbox"
        name="pickup"
        <%= listing.pickup ? 'checked' : '' %>>
        Pickup
    </label>

    <br>
    
    <label>
        <input type="checkbox"
        name="delivery"
        <%= listing.delivery ? 'checked' : '' %>>
        Delivery
    </label>

    <br>

    <label>
        <input type="checkbox"
        name="appointment"
        <%= listing.appointment ? 'checked' : '' %>>
        Appointment
    </label>

    <br>

    <label>
        <input type="checkbox"
        name="mobileService"
        <%= listing.mobileService ? 'checked' : '' %>>
        Mobile Service
    </label>

    <br><br>

    <button type="submit">Save Changes</button>
</form>
</body>
</html>