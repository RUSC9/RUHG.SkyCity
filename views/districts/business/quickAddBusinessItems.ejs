
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quick Add Items | Sky City</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f0f9ff;
      color: #183153;
      padding: 24px;
    }

    main {
      max-width: 1200px;
      margin: auto;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: white;
    }

    th, td {
      padding: 10px;
      border: 1px solid #cbd5e1;
    }

    input, select {
      width: 100%;
      box-sizing: border-box;
      padding: 8px;
    }

    button {
      padding: 10px 16px;
      margin: 10px 6px 10px 0;
      cursor: pointer;
    }

    .primary {
      background: #0284c7;
      color: white;
      border: none;
      border-radius: 6px;
    }
  </style>
  
<link rel="stylesheet" href="/css/business.css">

<link rel="stylesheet" href="/css/business-quick-add.css">

</head>

<body>
    
<!-- Sky City Business Navigation -->
<nav class="business-page-navigation">

    <a
        href="/business/<%= business._id %>"
        class="business-back-btn"
    >
        ← Back to My Storefront
    </a>

    <a
        href="/city-center/business"
        class="business-back-btn"
    >
        Business Dashboard
    </a>

    <a
        href="/auth/logout"
        class="business-back-btn business-logout-btn"
    >
        Logout
    </a>

</nav>

<main>
  <h1>Quick Add Products & Services</h1>
  <p>Business: <%= business.businessName %></p>

  <form
    action="/business-listings/<%= business._id %>/items/quick-add"
    method="POST"
    id="quickAddForm"
  >
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Item Name</th>
            <th>Type</th>
            <th>Category</th>
            <th>Description</th>
            <th>Price ($)</th>
            <th>Image URL</th>
            <th>Remove</th>
          </tr>
        </thead>
        <tbody id="itemRows"></tbody>
      </table>
    </div>

    <button type="button" id="addRow">
      + Add Another Row
    </button>

   
<p class="inventory-moderation-notice">
    New items will remain pending until moderation is completed.
</p>


    <button type="submit" class="primary">
      Submit All Items
    </button>
  </form>

  <p>
    <a href="/business/<%= business._id %>">
      Return to Business Page
    </a>
  </p>
</main>

<script>
 
const itemRows = document.getElementById("itemRows");
const addRowButton = document.getElementById("addRow");
const quickAddForm = document.getElementById("quickAddForm");

const MAX_ROWS = 50;
let nextRowIndex = 0;

function addItemRow() {
  if (itemRows.rows.length >= MAX_ROWS) {
    alert("You can add up to 50 items at a time.");
    return;
  }

  const index = nextRowIndex++;
  const row = document.createElement("tr");

    row.innerHTML = `
      <td>
        <input name="items[${index}][name]"
          maxlength="150" required>
      </td>
      <td>
        <select name="items[${index}][itemType]" required>
          <option value="">Select</option>
          <option value="product">Product</option>
          <option value="service">Service</option>
        </select>
      </td>
      <td>
        <input name="items[${index}][category]">
      </td>
      <td>
        <input name="items[${index}][description]">
      </td>
      <td>
        <input type="number" name="items[${index}][price]"
          min="0" step="0.01">
      </td>
      <td>
        <input type="url" name="items[${index}][imageUrl]">
      </td>
      <td>
        <button type="button" class="remove-row">
          Remove
        </button>
      </td>
    `;

    row.querySelector(".remove-row").addEventListener(
      "click",
      () => {
        if (itemRows.rows.length > 1) {
          row.remove();
        }
      }
    );

    itemRows.appendChild(row);
  }

  addRowButton.addEventListener("click", addItemRow);

  quickAddForm.addEventListener("submit", (event) => {
    if (itemRows.rows.length === 0) {
      event.preventDefault();
      alert("Add at least one item.");
    }
  });

  addItemRow();
</script>
</body>

</html>

