<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset = "UTF-8">
    <meta name = "viewport"

content=" width=device-width,initial-scale=1.0">
<title> Add Product or Service | Sky City</title>

<link rel="stylesheet" href="/css/business.css">
<link rel="stylesheet" href="/css/business-inventory.css">

</head>

<body>

<!-- Sky City Business Navigation -->
<nav class="business-page-navigation">
    <a
        href="/business/<%= business._id %>"
        class="business-back-btn"
    >
        ← Back to My Storefront
    </a>

    <a
        href="/city-center/business"
        class="business-back-btn"
    >
        Business Dashboard
    </a>
</nav>

    <main>
        <h1>Add Product or Service</h1>
<p>
    Business: <%=business.businessName %>
</p>

<div class="inventory-quick-add">
    <span>Adding more than one product or service?</span>

    <a
        href="/business-listings/<%= business._id %>/items/quick-add"
        class="inventory-quick-add-link"
    >
        Quick Add Multiple Items →
    </a>
</div>

<!-- Inventory Entry Options -->
<div class="inventory-entry-options">

    <span class="inventory-option-active">
        <icon>＋</icon> Add Single Item
    </span>

    <a
        href="/business-listings/<%= business._id %>/items/quick-add"
        class="inventory-option-link"
    >
        ＋ Add Multiple Items
    </a>

</div>

 <form
   action="/business-listings/<%=business._id %>/items"
   method="POST"
   >

<div>
    <label 
    for="name"> Item Name</label>
    <input
    type="text"
    id="name"
    name="name"
    required
    maxlength="150"
    >
</div>

<div>
    <label
        for="itemType">Item Type</label>
    <select 
    id="itemType" 
    name="itemType"
    required>
<option
value="">Select Type</option>
<option
value="product">Product</option>
<option
value="service">Service</option>


</select>
</div> 

<div> 
    <label
    for="category">Category</label>
    <input
    type="text"
    id="category"
    name="category"
    >
</div>

<div>
<label
for="description">Description</label>
<textarea
id="description"
name="description"
rows="5"
></textarea>
</div>

<div>
    <label
for="price">Price($)</label>
<input
type="number"
id="price"
name="price"
min="0"
step="0.01"
>
</div>

<div>
    <label
    for="imageUrl">Image URL</label>
    <input
    type="url"
    id="imageUrl"
    name="imageUrl"
    placeholder="https://example.com/image.jpg">
</div>

<p>
    Submitted items will remain pending until content moderation is completed.
</p>

<button
type= "submit">Add Product or Service</button></form>
   <p>
    <a href="/business/<%=business.id%>">
        Return to Business Page
    </a>
   </p> 
</main>
</body>
</html>