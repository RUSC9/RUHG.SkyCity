<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sky City | Consumer Account Details</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      color: #102b60;

      background:
        linear-gradient(
          rgba(225, 242, 255, 0.35),
          rgba(239, 229, 255, 0.55)
        ),
        url("/images/skycity-executive-office.png")
        center center / cover fixed;
    }

    .container {
      max-width: 1000px;
      margin: 50px auto;
      padding: 25px;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 25px;
      color: #102b60;
      font-weight: bold;
      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    .panel {
      padding: 35px;
      border-radius: 20px;

      background: rgba(235, 245, 255, 0.88);

      backdrop-filter: blur(15px);

      box-shadow:
        0 10px 30px rgba(20, 45, 90, 0.15);
    }

    h1 {
      margin-top: 0;
      font-size: 30px;
    }

    .subtitle {
      margin-bottom: 30px;
      color: #405b85;
    }

    .details-grid {
      display: grid;

      grid-template-columns:
        repeat(auto-fit, minmax(250px, 1fr));

      gap: 20px;
    }

    .detail-card {
      padding: 25px;
      border-radius: 15px;
      background: rgba(255, 255, 255, 0.95);

      box-shadow:
        0 5px 15px rgba(0, 0, 0, 0.08);
    }

    .detail-card h3 {
      margin-top: 0;
      color: #102b60;
    }

    .detail-card p {
      margin-bottom: 0;
      overflow-wrap: anywhere;
    }

    .status-active {
      color: #16803c;
      font-weight: bold;
    }

    .status-inactive {
      color: #c0392b;
      font-weight: bold;
    }

    .notice {
      margin-top: 30px;
      padding: 18px;

      border-radius: 12px;

      background: rgba(215, 235, 255, 0.85);

      color: #244a7c;
    }

    @media (max-width: 600px) {
      .container {
        margin: 20px auto;
        padding: 15px;
      }

      .panel {
        padding: 22px;
      }
    }
  </style>
</head>

<body>

  <main class="container">

    <a
      href="/admin/subscribers"
      class="back-link"
    >
      ← Back to Subscriber Management
    </a>

    <section class="panel">

      <h1>👤 Consumer Account Details</h1>

      <p class="subtitle">
        Sky City Executive Account Overview
      </p>

      <div class="details-grid">

        <!-- Consumer Name -->
        <div class="detail-card">

          <h3>👤 Full Name</h3>

          <p>
            <%= consumer.firstName || "" %>
            <%= consumer.lastName || "" %>
          </p>

        </div>

        <!-- Email Address -->
        <div class="detail-card">

          <h3>📧 Email Address</h3>

          <p>
            <%= consumer.email || "Not available" %>
          </p>

        </div>

        <!-- Account Status -->
        <div class="detail-card">

          <h3>🛡️ Account Status</h3>

          <p class="<%= consumer.isActive ? 'status-active' : 'status-inactive' %>">

            <%= consumer.isActive ? "Active" : "Inactive" %>

          </p>

        </div>

        <!-- Registration Date -->
        <div class="detail-card">

          <h3>📅 Registration Date</h3>

          <p>
            <%= consumer.createdAt
              ? new Date(consumer.createdAt).toLocaleDateString()
              : "Not available" %>
          </p>

        </div>

      </div>

      <!-- Administrative Notice -->
      <div class="notice">

        <strong>Executive Administration Notice</strong>

        <p>
          This account overview is currently read-only.
          Account modifications and administrative actions
          will require authorized permissions and
          appropriate audit logging.
        </p>

      </div>

    </section>

  </main>

</body>
</html>