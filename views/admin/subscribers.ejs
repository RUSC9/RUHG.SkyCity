<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sky City | Subscriber Management</title>

  <style>
    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      color: #102b60;
      background:
        linear-gradient(
          rgba(225, 242, 255, 0.35),
          rgba(239, 229, 255, 0.55)
        ),
        url("/images/skycity-executive-office.png")
        center center / cover fixed;
    }

    .container {
      max-width: 1100px;
      margin: 50px auto;
      padding: 25px;
    }

    .panel {
      padding: 30px;
      border-radius: 20px;
      background: rgba(245, 249, 255, 0.88);
      backdrop-filter: blur(15px);
      box-shadow: 0 10px 30px rgba(20, 45, 90, 0.15);
    }

    h1 {
      margin-top: 0;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(
        auto-fit,
        minmax(200px, 1fr)
      );
      gap: 20px;
      margin-top: 25px;
    }

    .stat-card {
      background: white;
      padding: 25px;
      border-radius: 15px;
      text-align: center;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    }

    .stat-card h2 {
      color: #102b60;
    }

    .back-link {
      display: inline-block;
      margin-bottom: 20px;
      color: #102b60;
      font-weight: bold;
      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <main class="container">

    <a href="/admin/dashboard" class="back-link">
      ← Back to Executive Command Center
    </a>

    <section class="panel">

      <h1>👥 Subscriber Management</h1>

      <p>
        Sky City Consumer and Business Account Overview
      </p>

      <div class="stats">

        <div class="stat-card">
          <h2>Total Accounts</h2>
          <p><%= totalSubscribers %></p>
        </div>

        <div class="stat-card">
          <h2>Consumers</h2>
          <p><%= totalConsumers %></p>
        </div>

        <div class="stat-card">
          <h2>Businesses</h2>
          <p><%= totalBusinesses %></p>
        </div>

      </div>

    </section>

  </main>
</body>
</html>