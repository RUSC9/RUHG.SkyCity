<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name=""viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
    </head>
    <body>
        <main>
            <h1>Welcome Back to Sky City</h1>
            <p>Log in to your account.</p>
            <form action="/auth/login" method="POST">
                <label for="email">Email</label>
                <input
                type="email"
                id="email"
                name="email"
                required>
                <label for="password">Password</label>
                <input
                type="password"
                id="password"
                name="password"
                required>
                <button type="submit">Log in</button>
            </form>

            <p>
                New to Sky City?
                <a href="/auth/register/consumer">Consumer Registration</a>
                |
                <a href="/auth/register/business">Business Registration</a>
            </p>
        </main>
    </body>
</html>