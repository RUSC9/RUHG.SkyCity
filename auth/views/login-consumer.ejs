<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sky City - consumer Login</title>
</head>
<body>
    <main>
            <h1>Consumer Login</h1>

        <form action="/auth/login/consumer" method="POST">
        <label for="email">Email</label>
                <input 
                type="email"
                id="email"
                name="email"
                required>
                    
        <label for="password">Password</label>
                <input
                type="password"
                id="password"
                name="password"
                required>

        <button type="submit">Log in</button>
        </form>

        <p>
            Need an Account?
            <a href="/auth/register/consumer">Create Consumer Account</a>
        </p>
        </main>
    </body>
</html>