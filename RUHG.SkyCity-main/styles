/* Global Urban Theme */
body {
    margin: 0;
    padding: 0;
    font-family: 'Montserrat', sans-serif;
    background: url('../public/images/city-street-bg.jpg') no-repeat center center fixed;
    background-size: cover;
    color: #f2f2f2;
}

/* Navigation */
.city-nav {
    background: rgba(20, 20, 20, 0.85); /* subway station dark */
    padding: 20px;
    border-bottom: 3px solid #ffcc00; /* cinema marquee gold */
}

.city-nav ul {
    list-style: none;
    display: flex;
    justify-content: space-around;
    margin: 0;
    padding: 0;
}

.city-nav a {
    text-decoration: none;
    color: #f2f2f2;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 10px 15px;
    transition: 0.3s;
}

.city-nav a:hover {
    background: #ffcc00; /* marquee glow */
    color: #000;
    border-radius: 4px;
}

/* Home Page Hero */
.hero {
    height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    backdrop-filter: blur(3px);
    text-align: center;
}

.hero h1 {
    font-size: 4rem;
    text-shadow: 3px 3px 10px #000;
}

.hero p {
    font-size: 1.5rem;
    max-width: 700px;
    text-shadow: 2px 2px 6px #000;
}

/* District Buttons */
.district-buttons {
    margin-top: 40px;
    display: flex;
    gap: 20px;
}

.district-buttons a {
    padding: 15px 25px;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid #ffcc00;
    color: #ffcc00;
    text-decoration: none;
    font-weight: bold;
    border-radius: 6px;
    transition: 0.3s;
}

.district-buttons a:hover {
    background: #ffcc00;
    color: #000;
}
