section {
    width: 90%;
    margin: 0 auto;
}
 
aside {
    width: 30%;
    float: left;
}
 
article {
    width: 65%;
    float: right;
}
 
img {
    max-width: 50%;
}


  table {
      
      background-color: lightskyblue;
      text-align: center;
  } 
    td, th{
       
        margin-left: auto;
        margin-right: auto;
        background-color: lightskyblue;
    
    
  }

