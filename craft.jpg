/* http://meyerweb.com/eric/tools/css/reset/ 
   v2.0 | 20110126
   License: none (public domain)
   */

   /* HTML5 display-role reset for older browsers */
   article, aside, details, figcaption, figure, 
   footer, header, hgroup, menu, nav, section {
    display: block;
  }
  
   header nav {
        float: left;
        width: 989px;
    }
    header nav li {
        display: inline;
        font-size: 10px;
        padding-right: 25px;
        color: darkblue;
        
    }
    /*Unordered list and Nav paths*/
    .new-nav {

        font-family: Segoe UI, Arial, Helvetica, sans-serif;
        color: darkorange;
        font-weight: bold;
        margin: 5px;
        border: solid 3px lightskyblue;
       
    }
    
    /*Sign on Box Style*/
    .new-nav2 {
        width: 400px;
        height:300px;
        font-family: Segoe UI, Arial, Helvetica, sans-serif;
        color: darkblue;
        font-weight: bold;
        font-size: 24px;
        margin: 5px;
        text-align: center;
       
    }
      /*NewAccount Box Style*/
       .new-nav3 {
        display:inline-block;
        width: 400px;
        height:650px;
        margin: 5px;
        text-align: left;
        font-family: Segoe UI, Arial, Helvetica, sans-serif;
        border: solid 5px white;
        background-color: lightskyblue;
       }
       .input-box{
        width: 250px;
        display:inline-block;
        text-align: right;
        
        
       }
       

    /*Radio Question Box Style*/
       .new-nav4 {
        width: 300px;
        height:225px;
        font-family: Segoe UI, Arial, Helvetica, sans-serif;
        border: solid 1px white;
        text-align: center;
        border: solid 3px lightskyblue;
    }
       
  ol, ul {
    list-style: none;
  }

  /*set body style background graphics and text-shadow */
   body {
    font-family: "ariel", "san-serif";
    border-radius: 25px;
    background: lightskyblue;
    color: darkblue;
    display: block;
    background-image: url("https://clipartion.com/wp-content/uploads/2015/12/autumn-leaves-png-images-free-png-yellow-leaves.png");
    background-repeat: no-repeat;
    background-position: right bottom;
    
  }
  /* H1 (FALL TV SEPTEMBER) TOPOGRAPHY*/
    .title {
        color: aliceblue;
        font-size: 48px;
        text-decoration: none;
        text-shadow: 0 32px 32px #2e2e31, 0 32px 32px #2e2e31;
        font-weight: bold;
        margin: 0;
    }
   /*Set nav header topography graphics*/ 
     a {
        color: aliceblue;
        font-size: 24px;
        text-decoration: none;
        text-shadow: 0 12px 12px #2e2e31, 0 12px 12px #2e2e31;
        font-weight: bold;
        margin: 35px;
        padding: 25px;
        
    }
   a: before,
   a:after {
       content: " ";
       display: inline-block;
       border: 15px solid #c6b497;
       color:darkorange;

   }
   a: before {
       border-color: #c6b497 #c6b497 rgba(0,0,0,0) rgba(0,0,0,0); z-index:-1;
   }
   a: after {
       border-color:rgba(0,0,0,0) rgba(0,0,0,0) #c6b497;
       text-shadow: 55px 55px 55px rgba(46,46,49,.8);
   }
   @keyframes rotate{
       0%{
       transform: translateX(-50%) translateY(-50%) rotate(0deg);
   }
      100%{
       transform: translateX(-50%) translateY(-50%) rotate(360deg);
       
       
     }
}
  blockquote, q {
    quotes: none;
  }
  blockquote:before, blockquote:after,
  q:before, q:after {
    content: '';
    content: none;
  }
.simple-form{
    width: 300px;
    display:inline-block;
    border-radius: 5px;
    vertical-align: top;
}
.simple-form label {
    font-weight: bold;
}
.simple-form input[type=text], 
.simple-form select, 
.simple-form input[type=password], 
.simple-form textarea{
    width: 150px;
}
.simple-form input[type=submit]{
    background-color: #1638a5;
    color: white;
    border-radius: 15px;
    padding: 5px;
    margin-top: 25px;
    border: solid 1px black;
}
.simple-form #searchResults{
    border: solid 1px blue;
    background-color:#4163bd;
}

 #postResults{
    display: inline-block;
    vertical-align: top;
    background-color: #d6eaf9;
 }
.Post-form{
    display:inline-block;
    border-radius: 5px;
    vertical-align: top;
}
.Post-form label {
    font-weight: bold;
}
.Post-form input[type=text], 
.Post-form select, 
.Post-form input[type=password], 
.Post-form textarea{
    width: 500px;
    Height: 80px;

}

