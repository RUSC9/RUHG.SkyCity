/*=========================================
    Main Styles
    =========================================*/
   .container {
      width: 989px;
      margin: 0 auto;
      color: black;
    }

    .footer {
      text-align: center;
    }
  /*N9N logo styling details*/  
  .notfixed {
    float: right;
    bottom: 0;
    right: 0;
    
  }
  /*FTS logo styling details*/ 
 .floated-image {
    float: left;
    width:200px;
 
  }
  /* audio and video style details*/
 .graphics {
   display: inline-block;
   width: 300px;
   height: 200px;
   text-align: center;
  }
    /* h1 style details*/
 .font-style {
   color: white;
   font: bold;
  }

  /* align data left-right until the end of the row then follow on next row*/
   .inline-block {
   display: inline-block;
   width: 100px;
   height: 100px;
   text-align: right;
   color: lightskyblue;
 
  }
  /* color distinction- topogrophy */
